*.swp
*.swo
*~

# Night shift working files
.night-shift/

# Extracted figures (output)
*_figures/
*.zip

# Python
__pycache__/
*.pyc

# Evaluation run log (lives in the projects dir, but ignore if run inside the repo)
scores.jsonl
score-results.json

# Claude working notes (local, not for the public repo)
CLAUDE-HANDOFF.md
BUG-REPORT.md
tasks/

# Generated evaluation artifacts (regenerate with eval/*.py) + copyrighted figure crops
eval/charts/
eval/charts_real/
eval/results/
eval/results_imgonly/
eval/tasks/
eval/tasks_imgonly/
eval/vtasks/
eval/vresults/
eval/vtruth.json
eval/results_real/
# generated benchmark artifacts (regenerate deterministically from the seeded generators; keep code + reports)
benchmark/corpus/
benchmark/tasks/
benchmark/vision/
bench/charts/
bench/tasks/
bench/vision/
bench/truth.json
bench/floor.json
# real-figure crops from published articles (copyright)
benchmark/real/panels/
# ...and anything derived from them that carries the pixels onward. The read report embeds
# the panels as base64 JPEG, so the `*.png` rule below does not cover it. Regenerate with
# `python3 overlay_reads.py && python3 make_read_report.py` -- the generators are committed.
benchmark/real/out/overlays/
benchmark/real/out/read-report.html
# classification corpus: keep GT labels + code, drop regenerable synthetic renders
benchmark/classify/corpus/*.png
benchmark/classify/tasks/img/
# panel-detection corpus: keep the GT answer key + code, drop regenerable renders and the
# solo per-element renders the GT boxes were measured from
benchmark/panels/corpus/*.png
benchmark/panels/corpus/*.part.json
benchmark/panels/corpus/_iso/
benchmark/panels/tasks/img/
benchmark/panels/__pycache__/
# series/group parsing corpus: keep the GT answer key + code, drop regenerable renders
benchmark/series/corpus/*.png
benchmark/series/corpus_stress/*.png
benchmark/series/tasks/img/
benchmark/series/tasks_stress/img/
benchmark/series/__pycache__/
# human real-figure validation: keep the protocol, harness, plan, sealed key, the rater's
# exports (coordinates only) and the normalized GT store. Drop the session working tree --
# rendered journal pages and their extracted text layer are copyrighted third-party
# content, and every render is regenerable from the PDFs via prepare_session.py.
benchmark/real-validation/sessions/*/projectA/
benchmark/real-validation/sessions/*/projectB/
benchmark/real-validation/worklist.derived.json
benchmark/real-validation/__pycache__/
# generated: maps DOIs to a LOCAL Zotero library (personal paths); regenerate with resolve_pdfs.py
benchmark/real/pdf_map.json
# editor / OS / office cruft
.obsidian/
~$*
Rplots.pdf
